#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Rclone Web GUI
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

bashio::log.info "Starting Rclone Web GUI..."

RCLONE_RC_ARGS=(
  --rc-web-gui-no-open-browser
  --rc-addr ":8099"
  --rc-allow-origin "172.30.32.2"
  --rc-files "/usr/share/rclone-webui-react"
)

run_rclone_rc() {
  # rclone prints a convenience Web GUI URL containing basic-auth credentials
  # and login_token even when credentials are supplied via environment variables.
  # Filter that single startup notice before it reaches the add-on log.
  rclone rcd "${RCLONE_RC_ARGS[@]}" "$@" 2>&1 | while IFS= read -r line; do
    if [[ "${line}" == *"Web GUI is not automatically opening browser. Navigate to http"* ]]; then
      line="${line%%Navigate to http*}Navigate to http://<redacted>/ to use."
    fi
    printf '%s\n' "${line}"
  done
  return "${PIPESTATUS[0]}"
}

if bashio::config.true 'rc_auth_enabled'; then
  # HA Ingress opens the Web UI at / and cannot pass rclone's generated
  # login_token. Enabling rclone RC auth therefore breaks the Ingress login flow,
  # and rclone also prints that token in its startup URL. Keep the Web UI usable
  # and avoid secret-bearing startup URLs by relying on Home Assistant Ingress.
  bashio::log.warning "rc_auth_enabled is ignored for the Web GUI; relying on Home Assistant Ingress authentication to avoid rclone login-token leaks."
else
  bashio::log.warning "Rclone Web GUI authentication is disabled; relying on Home Assistant Ingress only."
fi

run_rclone_rc --rc-no-auth
