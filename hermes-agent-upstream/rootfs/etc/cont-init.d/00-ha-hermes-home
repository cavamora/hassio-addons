#!/command/with-contenv sh
# Seed the upstream environment for this add-on's own persistent state.
set -eu

TARGET=/config/.hermes

printf '%s' "$TARGET" > /run/s6/container_environment/HERMES_HOME
# `media` and `share` are explicit read/write HAOS mounts in config.yaml.
# Permit Hermes file tools to write there as well as its private state; do not
# include other add-ons' private configuration volumes.
printf '%s' "$TARGET:/media:/share" > /run/s6/container_environment/HERMES_WRITE_SAFE_ROOT
printf '%s' '/config' > /run/s6/container_environment/HOME

# Home Assistant grants this add-on a short-lived Supervisor token when
# `homeassistant_api: true` is declared in config.yaml. Expose that token only
# through the s6 runtime environment for Hermes' native HA tools; never copy it
# to the persistent Hermes .env/config state or emit it in logs. Hermes appends
# `/api/...` itself, hence the `/core` base rather than `/core/api` here.
python3 - <<'PY'
import json
import os
from pathlib import Path

env_dir = Path('/run/s6/container_environment')
token_target = env_dir / 'HASS_TOKEN'
url_target = env_dir / 'HASS_URL'
try:
    options = json.loads(Path('/data/options.json').read_text(encoding='utf-8'))
except (OSError, ValueError):
    options = {}

enabled = options.get('homeassistant_tools_enabled', True) is True
token = ''
if enabled:
    for name in ('SUPERVISOR_TOKEN', 'HASSIO_TOKEN'):
        candidate = env_dir / name
        if candidate.exists():
            token = candidate.read_text(encoding='utf-8').strip()
            if token:
                break

if token:
    url_target.write_text('http://supervisor/core', encoding='utf-8')
    token_target.write_text(token, encoding='utf-8')
    os.chmod(url_target, 0o600)
    os.chmod(token_target, 0o600)
    print('[ha-hermes] Native Home Assistant entity/service tools enabled through the Supervisor Core API.', flush=True)
else:
    url_target.write_text('', encoding='utf-8')
    token_target.write_text('', encoding='utf-8')
    os.chmod(url_target, 0o600)
    os.chmod(token_target, 0o600)
    if enabled:
        print('[ha-hermes] WARNING: Home Assistant tools requested but no Supervisor token is available.', flush=True)
    else:
        print('[ha-hermes] Home Assistant entity/service tools disabled by add-on configuration.', flush=True)
PY

# The Dashboard Chat tab is an embedded Hermes TUI backed by a PTY. Keep it
# configurable at the HA add-on boundary and disabled only when requested.
terminal_enabled="$(python3 - <<'PY'
import json
from pathlib import Path
try:
    options = json.loads(Path('/data/options.json').read_text(encoding='utf-8'))
except (OSError, ValueError):
    options = {}
print('1' if options.get('dashboard_terminal', True) is True else '0')
PY
)"
printf '%s' "$terminal_enabled" > /run/s6/container_environment/HERMES_DASHBOARD_EMBEDDED_CHAT_ENABLED
if [ "$terminal_enabled" = 1 ]; then
    echo "[ha-hermes] Dashboard interactive terminal enabled." >&2
else
    echo "[ha-hermes] Dashboard interactive terminal disabled by add-on configuration." >&2
fi

# The browser shell is deliberately separate from the Dashboard TUI. It is
# disabled unless the user supplies an explicit password; its credentials are
# written only to /run (tmpfs), never into Hermes state or logs.
python3 - <<'PY'
import json
import os
from pathlib import Path

state = Path('/run/s6/container_environment/HERMES_SHELL_TERMINAL_ENABLED')
creds = Path('/run/hermes-shell-terminal-credentials')
try:
    options = json.loads(Path('/data/options.json').read_text(encoding='utf-8'))
except (OSError, ValueError):
    options = {}

enabled = options.get('shell_terminal_enabled') is True
username = str(options.get('shell_terminal_username') or '').strip()
password = str(options.get('shell_terminal_password') or '')
if enabled and username and password and '\n' not in username and '\n' not in password:
    creds.write_text(f'{username}\n{password}\n', encoding='utf-8')
    os.chmod(creds, 0o600)
    state.write_text('1', encoding='ascii')
    print('[ha-hermes] Authenticated browser shell enabled on TCP 7681.', flush=True)
else:
    creds.unlink(missing_ok=True)
    state.write_text('0', encoding='ascii')
    if enabled:
        print('[ha-hermes] Browser shell remains disabled: set shell_terminal_username and shell_terminal_password.', flush=True)
PY

# HAOS mounts these shared roots as root:root 0755. The gateway itself runs as
# the unprivileged `hermes` user, so make only the two mount roots group-writable
# (not recursive) and inherit the group for new folders. Existing files and
# folders retain their owner/mode; this avoids a destructive permission sweep
# over user media.
for shared_root in /media /share; do
    if [ -d "$shared_root" ]; then
        if chgrp hermes "$shared_root" && chmod 2775 "$shared_root"; then
            echo "[ha-hermes] Enabled Hermes write access at $shared_root" >&2
        else
            echo "[ha-hermes] WARNING: Could not enable Hermes write access at $shared_root" >&2
        fi
    fi
done

# Root-only storage publisher queue. Hermes may submit confined move/remove
# requests, while only the separate publisher service writes the CIFS media mount.
queue=/run/hermes-storage
mkdir -p "$queue/requests" "$queue/results"
chown root:hermes "$queue" "$queue/requests" "$queue/results"
chmod 2750 "$queue" "$queue/results"
chmod 2770 "$queue/requests"

# Ensure the persisted state is accessible to the unprivileged upstream service.
if [ -d "$TARGET" ] && find "$TARGET" -xdev \( ! -uid 10000 -o ! -gid 10000 \) -print -quit | grep -q .; then
    chown -R 10000:10000 "$TARGET"
    echo "[ha-hermes] Normalized Hermes state ownership." >&2
fi
