#!/command/with-contenv sh
# Start selected existing profiles through Hermes' own s6 lifecycle. This is
# boot policy only; the official image still owns service registration,
# supervision, restarts, logs, and profile isolation.
set -eu

OPTIONS_FILE=/data/options.json
[ -f "$OPTIONS_FILE" ] || exit 0

python3 - "$OPTIONS_FILE" <<'PY' | while IFS= read -r profile; do
import json
import re
import sys

try:
    configured = json.load(open(sys.argv[1], encoding="utf-8")).get("profiles_to_start", [])
except (OSError, ValueError, TypeError) as error:
    print(f"[ha-hermes] invalid profiles_to_start: {error}", file=sys.stderr)
    raise SystemExit(0)

if not isinstance(configured, list):
    print("[ha-hermes] profiles_to_start must be a list", file=sys.stderr)
    raise SystemExit(0)

for profile in configured:
    if isinstance(profile, str) and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", profile):
        print(profile)
    else:
        print(f"[ha-hermes] ignoring invalid profile name: {profile!r}", file=sys.stderr)
PY
    if [ ! -d "$HERMES_HOME/profiles/$profile" ]; then
        echo "[ha-hermes] profile '$profile' does not exist; skipping" >&2
        continue
    fi
    echo "[ha-hermes] starting profile gateway: $profile"
    if ! /opt/hermes/bin/hermes -p "$profile" gateway start; then
        echo "[ha-hermes] failed to start profile gateway: $profile" >&2
    fi
done
